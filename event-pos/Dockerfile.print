FROM node:20-alpine

# Install build tools and libusb required for compiling usb packages
RUN apk add --no-cache python3 make g++ eudev-dev linux-headers libusb-dev

WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/print-agent/package.json ./apps/print-agent/

# Install dependencies (rebuilds usb native module)
RUN npm install

COPY apps/print-agent ./apps/print-agent

WORKDIR /app/apps/print-agent
RUN npm run build

# Default environment (can be overridden in compose)
ENV SERVER_URL=http://localhost:3001

CMD ["npm", "start"]
